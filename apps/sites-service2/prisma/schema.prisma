generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/sites-client"
}

datasource db {
  provider = "postgresql"
}

model CpoConnection {
  id                   String    @id @default(uuid())
  actorId              String    @unique
  baseUrl              String
  authUrl              String?
  authType             String
  tenant               String?
  email                String?
  encryptedPassword    String?
  accessToken          String?
  refreshToken         String?
  tokenExpiresAt       DateTime?
  isConnected          Boolean   @default(false)
  fetchIntervalMinutes Int       @default(30)
  fetchEnabled         Boolean   @default(true)
  lastFetchAt          DateTime?
  nextFetchAt          DateTime?
  lastSyncAt           DateTime?
  sites                Site[]
  chargingStations     ChargingStation[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([actorId])
  @@index([isConnected])
  @@index([fetchEnabled])
  @@map("cpo_connections")
}

model Region {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  provider     String   @default("EDF")
  apiEndpoint  String?
  datasetId    String?
  apiKey       String?
  country      String   @default("France")
  countryCode  String   @default("FR")
  isActive     Boolean  @default(true)
  sites        Site[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([provider])
  @@index([countryCode])
  @@map("regions")
}

model Site {
  id                    String            @id @default(uuid())
  cpoConnectionId       String
  cpoConnection         CpoConnection    @relation(fields: [cpoConnectionId], references: [id], onDelete: Cascade)
  externalId            String
  name                  String
  address               String?
  city                  String?
  department            String?
  cpoRegion             String?
  regionId              String?
  region                Region?          @relation(fields: [regionId], references: [id])
  maxCapacityKw         Float?
  currentLimitKw        Float?
  reducedLimitKw        Float?
  manualOverrideLimitKw Float?
  manualOverrideUntil   DateTime?
  manualOverrideReason  String?
  isActive              Boolean           @default(true)
  lastSignalValue       Int?
  lastSignalAt          DateTime?
  lastLimitSetAt        DateTime?
  chargingStations      ChargingStation[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([cpoConnectionId, externalId])
  @@index([cpoConnectionId])
  @@index([regionId])
  @@index([isActive])
  @@map("sites")
}

model ChargingStation {
  id                String        @id @default(uuid())
  cpoConnectionId   String
  cpoConnection     CpoConnection @relation(fields: [cpoConnectionId], references: [id], onDelete: Cascade)
  externalId        String
  siteId            String?
  site              Site?         @relation(fields: [siteId], references: [id])
  chargePointId     String?
  vendor            String?
  model             String?
  firmwareVersion   String?
  ocppVersion       String?
  status            String?
  lastStatusAt      DateTime?
  maxPowerKw        Float?
  connectorsCount   Int           @default(0)
  connectorsJson    Json?
  latitude          Float?
  longitude         Float?
  lastSyncAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([cpoConnectionId, externalId])
  @@index([cpoConnectionId])
  @@index([siteId])
  @@index([status])
  @@map("charging_stations")
}